{
  "name": "MQTTBox",
  "version": "0.2.2-macos.1",
  "description": "MQTTBox - Developers helper program to create and test MQTT connectivity protocol.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andy1001Yu/MQTTBox.git"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:electron": "node test/electron-smoke.cjs",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "private": true,
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0",
    "aedes": "0.51.3",
    "websocket-stream": "5.5.2"
  },
  "dependencies": {
    "react": "15.3.2",
    "react-dom": "15.3.2",
    "react-router": "3.0.0",
    "flux": "3.1.0",
    "node-uuid": "1.4.7",
    "q": "1.4.1",
    "localforage": "1.4.3",
    "mqtt": "2.18.9",
    "react-copy-to-clipboard": "4.2.3",
    "qlobber": "0.7.0",
    "lodash": "4.18.1",
    "moment": "2.31.0",
    "fixed-data-table": "0.6.3",
    "recharts": "0.18.0",
    "compare-versions": "3.0.0"
  },
  "main": "build/platform/ElectronMain.js",
  "productName": "MQTTBox",
  "author": "Workswithweb <workswithweb@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.workswithweb.mqttbox",
    "productName": "MQTTBox",
    "directories": {
      "app": ".",
      "output": "dist",
      "buildResources": "porting/build-resources"
    },
    "files": [
      "build/**/*",
      "package.json",
      "porting/licenses/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "artifactName": "MQTTBox-${version}-mac-${arch}.${ext}",
      "icon": "porting/build-resources/icon.icns",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "MQTTBox ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "overrides": {
    "ws": "5.2.7",
    "d3-color": "3.1.0",
    "lodash": "$lodash",
    "isomorphic-fetch": {
      "node-fetch": "2.7.0"
    },
    "app-builder-lib": {
      "minimatch": "11.0.8"
    },
    "@electron/universal": {
      "minimatch": "11.0.8"
    },
    "aedes": {
      "uuid": "11.1.1"
    },
    "hyperid": {
      "uuid": "11.1.1"
    }
  }
}
